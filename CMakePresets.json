{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug development build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TESTS": "ON"
      }
    },
    {
      "name": "legacy",
      "displayName": "C++14 compatibility build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/legacy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DUNELEGACY": "ON",
        "TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "legacy",
      "configurePreset": "legacy"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "legacy",
      "configurePreset": "legacy",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
